APP_ENV=dev
DEBUG=True
APP_SECRET=django-insecure-change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8007
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
SECURE_PROXY_SSL_HEADER_ENABLED=False
TIME_ZONE=Asia/Dhaka
LOG_LEVEL=INFO

# database
DB_NAME=argon_db
DB_USER=argon_db_owner
DB_PASSWORD=argon_db_password
DB_HOST=localhost
DB_PORT=5432
DB_SSL_REQUIRE=False
ADK_DB_URL=

# google adk
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=

# gemini
GEMINI_INPUT_COST_PER_MILLION=0.30
GEMINI_OUTPUT_COST_PER_MILLION=2.50
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536
GEMINI_EMBEDDING_REQUEST_DELAY_SECONDS=5
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_CHAT_MAX_OUTPUT_TOKENS=1024
CHATBOT_AI_BACKEND=placeholder
CHATBOT_PLACEHOLDER_REPLY=Hello! How can I help you today?
WIDGET_CONVERSATION_TOKEN_TTL_SECONDS=2592000

# email
EMAIL_USE_TLS=True
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@argon.ai
EMAIL_VERIFICATION_OTP_TTL_MINUTES=10
WORKSPACE_INVITATION_TTL_HOURS=72
CHATBOT_INVITATION_TTL_HOURS=72

# celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TIMEZONE=Asia/Dhaka

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=argon-chatbot
# Optional when R2_ACCOUNT_ID is set.
R2_ENDPOINT_URL=
# Public custom domain or the bucket's r2.dev URL; do not include a trailing slash.
R2_PUBLIC_URL=
R2_REGION_NAME=auto
R2_FILES_PREFIX=files
R2_IMAGES_PREFIX=images
R2_IMAGE_CACHE_CONTROL=public, max-age=31536000, immutable
R2_PRESIGNED_URL_TTL=900

# knowledge source limit
KNOWLEDGE_MAX_FILE_SIZE_MB=10
KNOWLEDGE_MAX_PDF_PAGES=100
KNOWLEDGE_MAX_DOCX_PAGES=100
KNOWLEDGE_DOCX_WORDS_PER_PAGE=500
KNOWLEDGE_MAX_SPREADSHEET_ROWS=2500
KNOWLEDGE_MAX_CSV_ROWS=2500
KNOWLEDGE_MAX_STRUCTURED_ITEMS=2500
KNOWLEDGE_MAX_TEXT_WORDS=1000
KNOWLEDGE_CHUNK_SIZE=400
KNOWLEDGE_CHUNK_OVERLAP=50

# frontend 
USER_FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174
WIDGET_FRONTEND_URL=http://localhost:5175
# Optional when /ws is served on a different public host or port than the API.
WIDGET_WEBSOCKET_BASE_URL=ws://localhost:8008
PASSWORD_RESET_PATH=/reset-password
WORKSPACE_INVITATION_PATH=/workspace-invitation
CHATBOT_INVITATION_PATH=/chatbot-invitation

# stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:5173/settings/billing

# firebase
FIREBASE_VERIFY_ID_TOKEN=False
FIREBASE_SERVICE_ACCOUNT_JSON=

# superuser
SUPERUSER_NAME=
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# PORT
WSGI_PORT=8007
ASGI_PORT=8008
POSTGRES_FORWARD_PORT=5435
REDIS_FORWARD_PORT=6382
